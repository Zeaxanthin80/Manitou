# Local development: PostgreSQL 16 in Docker (docker compose up -d).
#
# Production is the same variable pointing at RDS PostgreSQL 16 in us-east-1 --
# Section 6.11's claim is that swapping this string is the whole change, because
# Alembic built both schemas. Phase 6 task 5 is where that gets tested.
#
# The RDS form is:
#   postgresql://manitou:<password>@<endpoint>.us-east-1.rds.amazonaws.com:5432/manitou?sslmode=require
#
# It is NOT written out here, and the real one never belongs in this file: it
# carries the master password, and RDS holds that in Secrets Manager rather than
# anywhere a person retypes it. sslmode=require matters -- the connection
# crosses the public internet.
DATABASE_URL=postgresql://manitou:devpassword@localhost:5432/manitou

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Which email implementation to use: "console" logs the message (development),
# "memory" keeps it in a list (tests). Phase 6 adds "ses".
EMAIL_SENDER=console

# Origin for links inside emails -- the web app, not the API.
APP_BASE_URL=http://localhost:3000

# --- Stripe (Phase 5) -------------------------------------------------------
# TEST keys only. A Stripe sandbox issues these immediately -- business
# verification is required for LIVE mode, not for these. Every value here must
# start with a _test_ or whsec_ prefix; an sk_live_ key in this file means real
# money is one request away.
#
# The SECRET key never leaves the server. It can create charges, issue refunds
# and read every customer -- treat it exactly like the database password.
STRIPE_SECRET_KEY=sk_test_replace_me
#
# The PUBLISHABLE key is designed to be public and ships to the browser. It can
# only start a payment the secret key has already authorised, so it is not a
# credential in the same sense. The web app needs its own copy as
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in web/.env.local.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
#
# Added in task 4, not now. Generated when the webhook endpoint is created in
# the dashboard, or printed by `stripe listen` when testing locally -- and it
# differs between the two, so a local secret will reject production events.
# Without it, anyone who finds the webhook URL can post a fake "payment
# succeeded" and mark orders paid.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
#
# Which payment implementation to build: "stripe" calls the real API in test
# mode, "fake" is in-memory and needs no network or key. Tests never read this
# -- they override the dependency -- so this only affects running the app.
PAYMENT_GATEWAY=stripe
