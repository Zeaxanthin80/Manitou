# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is DELIBERATELY committed -- it is the contract that
# documents which variables the app needs (PROJECT_PLAN Section 4.2). Real values
# never are.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated from the repo-root config files by scripts/build-tokens.mjs.
# Edit design-tokens.json / store-config.json instead.
/app/tokens.css
/lib/design-tokens.ts
/lib/store-config.ts
